<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.alpha-telemetry-publisher</string>

    <!-- The wrapper sources the ingest secret from ~/.sapphire/ so it never
         appears in this plist, in launchctl output, or in a Time Machine copy. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/aribs/Code/sapphire-alpha-dashboard/telemetry/run_publisher.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/aribs/autonomy-status/logs/alpha-telemetry-publisher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/autonomy-status/logs/alpha-telemetry-publisher.err</string>
</dict>
</plist>
