<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.alpha-telemetry-publisher</string>

    <!-- The wrapper sources the ingest secret from ~/.sapphire/ so it never
         appears in this plist or launchctl output. The active owner is pinned
         to the reviewed checkout; the retirement preflight binds its commit
         and file hashes before removing the competing cron owner. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/aribs/Code/.worktrees/sapphire-publisher-reviewed/telemetry/run_publisher.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SAPPHIRE_TELEMETRY_PYTHON</key>
        <string>/Users/aribs/Code/sapphire-alpha-dashboard/backend/.venv/bin/python</string>
    </dict>

    <!-- Publish cadence. This number and DEFAULT_STALE_AFTER_SECONDS in
         backend/live_telemetry.py are one decision split across two files, and
         they were set independently: a 300 s cadence against a 180 s staleness
         threshold meant the live feed read "stale" for 120 s of every cycle
         while the publisher was perfectly healthy. The threshold must cover a
         missed publish, so cadence * 2 < threshold. Asserted by
         backend/tests/test_machine_room_public.py, which reads THIS file. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/aribs/autonomy-status/logs/alpha-telemetry-publisher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/autonomy-status/logs/alpha-telemetry-publisher.err</string>
</dict>
</plist>
